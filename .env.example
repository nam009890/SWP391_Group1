# Set these variables in the same PowerShell process that starts Maven. No real secrets here.
AI_PROVIDER=gemini
AI_GENERATION_ENABLED=true
AI_MAX_CARDS=20
AI_REQUEST_TIMEOUT_SECONDS=30
AI_DAILY_REQUEST_LIMIT=10
AI_DAILY_GLOBAL_REQUEST_LIMIT=100
AI_MAX_CONCURRENT_PER_USER=1
AI_MAX_OUTPUT_TOKENS=6000
OPENAI_API_KEY=
OPENAI_MODEL=
DB_PASSWORD=
# Optional standard Spring environment names for Google OAuth:
SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_GOOGLE_CLIENT_ID=
SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_GOOGLE_CLIENT_SECRET=

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Opt-in local demo only; profile demo is also required. Never enable in production.
DEMO_SEED_ENABLED=false
DEMO_ADMIN_PASSWORD=
DEMO_LEARNER_PASSWORD=
DEMO_LOCKED_PASSWORD=
# Production requires a private signing secret of at least 64 bytes.
JWT_SECRET=
